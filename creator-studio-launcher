#!/bin/sh
# Launcher for the unpacked Linux build. It keeps Creator Studio usable on
# distributions without an FHS libEGL (for example NixOS) by falling back to
# the bundled SwiftShader renderer.
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
FLAGS="--no-sandbox"
USE_SOFTWARE=0

if [ "${CREATOR_STUDIO_GPU:-0}" != "1" ]; then
  SOFTWARE="${CREATOR_STUDIO_SOFTWARE_GL:-0}"
  if [ "$SOFTWARE" = "1" ] || ! command -v ldconfig >/dev/null 2>&1 || ! ldconfig -p 2>/dev/null | grep -q 'libEGL\.so\.1'; then
    USE_SOFTWARE=1
    if [ "${CREATOR_STUDIO_GL:-}" = "swiftshader" ]; then
      GLFLAGS="--use-gl=swiftshader"
    else
      GLFLAGS="--use-gl=angle --use-angle=swiftshader"
    fi
    FLAGS="$FLAGS $GLFLAGS --enable-unsafe-swiftshader --disable-gpu-sandbox --ignore-gpu-blocklist --enable-webgl --enable-features=Vulkan"
  fi
fi

# The SwiftShader Vulkan manifest uses a relative library path, and the app
# finds its resources relative to the install directory.
cd "$HERE" 2>/dev/null || true
if [ "$USE_SOFTWARE" = "1" ] && [ -f "$HERE/vk_swiftshader_icd.json" ]; then
  VK_ICD_FILENAMES="$HERE/vk_swiftshader_icd.json"
  VK_DRIVER_FILES="$HERE/vk_swiftshader_icd.json"
  export VK_ICD_FILENAMES VK_DRIVER_FILES
fi

exec "$HERE/creator-studio" $FLAGS "$@"
